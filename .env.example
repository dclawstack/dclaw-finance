# Backend
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dclaw_finance
APP_ENV=dev
DEBUG=true

# AI — set ONE of these two keys (OPENROUTER_API_KEY takes priority if both are set)
# Option A: OpenRouter (get key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Option B: Anthropic direct
ANTHROPIC_API_KEY=

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Auth
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Logto JWT auth — leave empty in dev to skip validation
# Set LOGTO_ENDPOINT to your Logto tenant URL (e.g. https://your-tenant.logto.app)
LOGTO_ENDPOINT=
LOGTO_RESOURCE=

# TestSprite AI testing (get key at https://www.testsprite.com/dashboard)
TESTSPRITE_API_KEY=
TESTSPRITE_BASE_URL=https://api.testsprite.com

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8096
